<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MinhaTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0b0b14</item>
        <item name="android:statusBarColor">#0b0b14</item>
        <item name="android:navigationBarColor">#0b0b14</item>
    </style>

    <style name="Theme.MinhaTV.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- janelinha "Áudio e legendas" do player: escura, letra grande para TV -->
    <style name="Theme.MinhaTV.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#FF6A3D</item>
        <item name="android:windowBackground">@drawable/player_pill</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C8CCD8</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
